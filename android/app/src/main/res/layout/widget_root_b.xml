<?xml version="1.0" encoding="utf-8"?>
<!-- Копия widget_root.xml (держать одинаковыми!). Виджет чередует два макета, чтобы лаунчер
     каждый раз заново создавал вид, а не «доприменял» обновление к старому (на Xiaomi/Samsung это молча не срабатывало). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/rounded_bg" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="Покупки"
                android:textColor="#FF1B1B1F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Фон чипа — отдельная картинка (setBackgroundResource лаунчеры не применяют) -->
            <FrameLayout
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_light" />

                <TextView
                    android:id="@+id/chip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Обновить"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Добавить"
                android:padding="7dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Вкладки ‹ Категория › — прямо в макете, без addView (вложенные RemoteViews лаунчер может не применить) -->
        <include
            android:id="@+id/tab_switch"
            layout="@layout/widget_tab_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:text="Загрузка…"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
