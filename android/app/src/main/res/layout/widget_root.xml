<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/rounded_bg" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Покупки"
                android:textColor="#FF1B1B1F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Поиск: открывает окно поверх рабочего стола (вводить текст в самом виджете Android не даёт) -->
            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:contentDescription="Поиск"
                android:padding="8dp"
                android:src="@drawable/ic_search" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Кнопка «Купить»: три варианта оформления (рамка / заливка светлая / тёмная),
                 показывается один. Фон задан в макете — так он надёжно рисуется на любом лаунчере. -->
            <FrameLayout
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                        android:id="@+id/chip_o"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_outline"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:visibility="visible" />
                <TextView
                        android:id="@+id/chip_l"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_fill_light"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:visibility="gone" />
                <TextView
                        android:id="@+id/chip_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_fill_dark"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Обновить"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/btn_add"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Добавить"
                android:padding="7dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Вкладки ‹ Категория › — прямо в макете, без addView (вложенные RemoteViews лаунчер может не применить) -->
        <include
            android:id="@+id/tab_switch"
            layout="@layout/widget_tab_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Вкладки-чипы в одну строку с листанием ‹ › (прокрутку пальцем виджеты Android не умеют).
             Заготовленные места, без addView — тогда работают частичные обновления. -->
