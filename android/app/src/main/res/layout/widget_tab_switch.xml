<?xml version="1.0" encoding="utf-8"?>
<!-- Компактные вкладки: ‹ Категория ›. Нажатие на название — выбор из списка. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/tab_prev"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:contentDescription="Предыдущая категория"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_left" />

    <TextView
        android:id="@+id/tab_current"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/chip_sel_light"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/tab_next"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:contentDescription="Следующая категория"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
